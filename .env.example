# =============================================================================
# NextWatch — Variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# Ne jamais committer `.env.local`.
# =============================================================================

# --- Supabase (base de données + auth + storage) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres (Project Settings -> Database -> Connection string, mode "Session pooler")
DATABASE_URL=

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mails transactionnels (optionnel) — Resend -------------------------------
RESEND_API_KEY=
EMAIL_FROM="NextWatch <noreply@nextwatch.app>"

# --- Stripe --------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_SOLO_PLUS=

# --- YouTube Data API v3 ---------------------------------------------------------
# Crée une clé sur Google Cloud Console (console.cloud.google.com) : active
# l'API "YouTube Data API v3" sur un projet, puis Identifiants -> Créer des
# identifiants -> Clé API. Utilisée UNIQUEMENT par le job planifié
# (api/cron/refresh-videos), jamais au moment d'un swipe utilisateur.
YOUTUBE_API_KEY=

# --- Cron de rafraîchissement des vidéos (Vercel Cron, voir vercel.json) --------
# Génère avec: openssl rand -hex 24
CRON_SECRET=

# --- Protection temporaire du site (optionnel) ----------------------------------
# Si défini, tout le site demande ce mot de passe (auth HTTP Basic) tant que
# le produit n'est pas prêt à être public. Laisser vide = site public.
SITE_PASSWORD=

# --- Suivi d'erreurs en production — Sentry (optionnel) -------------------------
# Crée un compte gratuit sur sentry.io, crée un projet "Next.js", puis colle
# le DSN fourni. Laisser vide = suivi d'erreurs désactivé, aucun impact.
SENTRY_DSN=

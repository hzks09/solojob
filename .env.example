# =============================================================================
# RoomAI — Variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# Ne jamais committer `.env.local`.
# =============================================================================

# --- Base de données (Neon Postgres) -----------------------------------------
# Chaîne de connexion "pooled" depuis le dashboard Neon (postgres://...)
DATABASE_URL=

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js v5 (e-mail/mot de passe uniquement) --------------------------------
# Générer avec: npx auth secret   (ou `openssl rand -base64 33`)
AUTH_SECRET=

# --- Envoi d'e-mails transactionnels (vérification, reset password) — Resend --
RESEND_API_KEY=
EMAIL_FROM="RoomAI <noreply@roomai.app>"

# --- Stockage images (Vercel Blob) ---------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Fournisseur IA (modulaire) -----------------------------------------------
# Valeurs possibles : "replicate" | "fal" | "openai" | "gemini" | "mock"
AI_PROVIDER=mock
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
FAL_API_KEY=
OPENAI_API_KEY=
# Gemini ("Nano Banana") — gratuit dans les limites du tier gratuit Google AI Studio
GEMINI_API_KEY=

# --- Stripe --------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# --- Rate limiting (Upstash Redis, optionnel mais recommandé en prod) --------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# SoloJob — Variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# Ne jamais committer `.env.local`.
# =============================================================================

# --- Supabase (base de données + auth + storage) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres (Project Settings -> Database -> Connection string, mode "Session pooler")
DATABASE_URL=

# --- Application ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Envoi d'e-mails transactionnels (relances de paiement) — Resend -----------
RESEND_API_KEY=
EMAIL_FROM="SoloJob <noreply@solojob.app>"

# --- Stripe --------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Endpoint webhook séparé, "Listen to events on Connected accounts" (paiements de factures)
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_SOLO_PLUS=

# --- Cron des relances (Vercel Cron, voir vercel.json) --------------------------
# Génère avec: openssl rand -hex 24
CRON_SECRET=

# --- Protection temporaire du site (optionnel) ----------------------------------
# Si défini, tout le site demande ce mot de passe (auth HTTP Basic) tant que
# le produit n'est pas prêt à être public. Laisser vide = site public.
SITE_PASSWORD=
